        <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">{{ $widget->getDescription() }}</p>
    @endif

    <p class="mt-2 text-2xl font-semibold text-gray-900 dark:text-white">{{ $value }}</p>
</div>
