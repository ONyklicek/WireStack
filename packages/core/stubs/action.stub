<?php

declare(strict_types=1);

namespace {{ namespace }};

use Illuminate\Database\Eloquent\Model;
use NyonCode\WireCore\Actions\Action;

/**
 * One configured action, reusable on any surface that takes an Action — a
 * table row, a page header, an infolist entry. Anything set here can still be
 * changed per use: `{{ class }}::make()->label('…')`.
 *
 * @phpstan-consistent-constructor
 */
class {{ class }} extends Action
{
    public function __construct(string $name = '{{ name }}')
    {
        parent::__construct($name);

        $this->label('{{ label }}')
            ->icon('bolt')
            ->requiresConfirmation()
            ->action(function (Model $record): void {
                // The record the action was triggered on. $data (the modal form's
                // values) and $action can be asked for by name, like $record.
            });
    }

    public static function make(string $name = '{{ name }}'): static
    {
        return new static($name);
    }
}
