<?php

declare(strict_types=1);

namespace {{ namespace }};

use {{ pageFqn }};
use NyonCode\WireCore\Core\Resources\Contracts\ProvidesNavigation;
use NyonCode\WireCore\Core\Resources\Navigation\NavigationItem;
use NyonCode\WireCore\Foundation\Routing\Contracts\ProvidesPages;
use NyonCode\WireCore\Widgets\Dashboard;
use NyonCode\WireCore\Widgets\Stat;
use NyonCode\WireCore\Widgets\StatsOverviewWidget;

class {{ class }} extends Dashboard implements ProvidesNavigation, ProvidesPages
{
    /**
     * The widgets on this dashboard, in the order they are laid out.
     */
    public function widgets(): array
    {
        return [
            StatsOverviewWidget::make()
                ->heading('{{ class }}')
                ->stats([
                    Stat::make('Records', '0'),
                ]),
        ];
    }

    /**
     * Columns in the grid.
     */
    public function columns(): int
    {
        return 2;
    }

    /**
     * The page that renders it, and what makes this dashboard reachable.
     *
     * A dashboard declaring no pages is routed nowhere: it appears in the menu
     * as an entry with no link, and typing its address is a 404. `Route::wireResources()`
     * reads this, and `{{ page }}` is the Livewire component generated beside
     * this class.
     *
     * Add `implements ConfiguresRoutes` with `routePrefix()` returning
     * `ConfiguresRoutes::ROOT` to put it on the panel's own path instead of
     * under a segment of its own.
     */
    public static function pages(): array
    {
        return ['index' => {{ page }}::class];
    }

    /**
     * The menu entry. Drop this method (and the interface) for a dashboard that
     * should not appear in navigation.
     */
    public static function navigation(): NavigationItem
    {
        return NavigationItem::make()
            ->icon('outline:chart-bar')
            ->group('insights');
    }
}
