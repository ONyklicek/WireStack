{
    "name": "nyoncode/wire-module-users",
    "description": "User administration for wire: a ready-made module with its resource, pages and optional role management.",
    "keywords": [
        "laravel",
        "livewire",
        "wire",
        "wirestack",
        "nyoncode",
        "users",
        "user-management",
        "roles",
        "permissions",
        "teams"
    ],
    "homepage": "https://wirestack.nyoncode.cz",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ondrej Nyklicek",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ONyklicek/WireStack/issues",
        "source": "https://github.com/NyonCode/wire-module-users",
        "docs": "https://wirestack.nyoncode.cz"
    },
    "require": {
        "php": "^8.2",
        "nyoncode/wire-core": "self.version",
        "nyoncode/wire-forms": "self.version",
        "nyoncode/wire-table": "self.version",
        "nyoncode/wire-panels": "self.version",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "nyoncode/laravel-package-toolkit": "^2.4.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "laravel/pint": "^1.29",
        "pestphp/pest": "^4.0|^5.0",
        "nyoncode/laravel-permission-extended": "^1.0"
    },
    "suggest": {
        "nyoncode/laravel-permission-extended": "Adds role and permission management to the module, with wildcard permissions and a super-admin gate."
    },
    "autoload": {
        "psr-4": {
            "NyonCode\\WireModuleUsers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NyonCode\\WireModuleUsers\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NyonCode\\WireModuleUsers\\WireModuleUsersServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
