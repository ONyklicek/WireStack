{
    "name": "nyoncode/wire-module-auth",
    "description": "The signed-out screens for wire: login, password reset, email verification and the two-factor challenge, over Laravel Fortify.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ondrej Nyklicek",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "nyoncode/wire-core": "self.version",
        "illuminate/support": "^12.0|^13.0",
        "laravel/fortify": "^1.30|^2.0",
        "nyoncode/laravel-package-toolkit": "^2.4.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "laravel/pint": "^1.29",
        "pestphp/pest": "^4.0|^5.0"
    },
    "suggest": {
        "nyoncode/wire-admin": "Supplies the frame these screens render in, so the login page matches the panel."
    },
    "autoload": {
        "psr-4": {
            "NyonCode\\WireModuleAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NyonCode\\WireModuleAuth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NyonCode\\WireModuleAuth\\WireModuleAuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
