{
    "name": "nyoncode/wire-table",
    "description": "Enterprise-grade Livewire table system with inline editing, optimistic locking, actions, bulk actions, and more.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ondřej Nyklíček",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "nyoncode/wire-core": "self.version",
        "nyoncode/wire-forms": "self.version",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "nyoncode/laravel-package-toolkit": "^2.4.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "laravel/pint": "^1.29",
        "pestphp/pest": "^4.0|^5.0",
        "openspout/openspout": "^4.0",
        "barryvdh/laravel-dompdf": "^3.0"
    },
    "suggest": {
        "openspout/openspout": "Real .xlsx workbooks for the Excel export. Without it ExcelExporter degrades to CSV and renames the file to match.",
        "barryvdh/laravel-dompdf": "PDF documents for the PDF export. Without it PdfExporter degrades to CSV and renames the file to match."
    },
    "autoload": {
        "psr-4": {
            "NyonCode\\WireTable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NyonCode\\WireTable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NyonCode\\WireTable\\WireTableServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
