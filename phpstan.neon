parameters:
    level: 6
    paths:
        - packages/core/src
        - packages/forms/src
        - packages/table/src
        - packages/panels/src
        - packages/boost/src
    tmpDir: build/phpstan
    excludePaths:
        # Concrete Livewire hosts that compose WithTable are not statically
        # analysable as concrete classes: WithTable relies on Livewire runtime
        # magic (dynamic __get/__set, method_exists guards, cross-trait calls)
        # and is only PHPStan-clean when checked as a trait via @phpstan-require-extends.
        # Every other concrete WithTable host (tests, workbench, wire-sortable) is
        # likewise outside the analysed paths; RelationManager is such a host base.
        - packages/table/src/RelationManagers/RelationManager.php
        # The resource pages are the same kind of host base: a concrete Livewire
        # component composing WithTable or WithForms, so analysing one as a class
        # drags the trait in as one too and reproduces the runtime-magic errors
        # above ($this->form comes from WithForms::__get, and so on).
        # ViewPage is deliberately absent — it composes no host trait, because a
        # read-only page has no state to bind and nothing to submit, so it stays
        # analysable like any other class. That is the test of whether a page
        # belongs on this list.
        - packages/panels/src/Resources/Pages/ListPage.php
        - packages/panels/src/Resources/Pages/CreatePage.php
        - packages/panels/src/Resources/Pages/EditPage.php
        # PanelComponent is a concrete Livewire host composing WithEditablePanel;
        # like RelationManager it depends on Livewire runtime magic and is only
        # analysable via the trait's @phpstan-require-extends, not as a class.
        - packages/core/src/Panels/PanelComponent.php
    scanFiles:
        - stubs/phpstan/optional-exporters.php
    ignoreErrors:
        # Public-API traits meant for consumer code, not analyzed internally
        - { identifier: trait.unused, path: packages/core/src/Actions/Concerns/HasButtonStyles.php }
        - { identifier: trait.unused, path: packages/core/src/Actions/Concerns/InteractsWithActions.php }
        - { identifier: trait.unused, path: packages/core/src/Audit/Concerns/HasAuditable.php }
        - { identifier: trait.unused, path: packages/core/src/Foundation/Concerns/HasLivewire.php }
        - { identifier: trait.unused, path: packages/core/src/Foundation/Concerns/InteractsWithPartials.php }
        - { identifier: trait.unused, path: packages/core/src/Infolists/Concerns/WithInfolists.php }
        - { identifier: trait.unused, path: packages/core/src/Panels/Concerns/WithEditablePanel.php }
        - { identifier: trait.unused, path: packages/core/src/Notifications/Concerns/InteractsWithNotifications.php }
        - { identifier: trait.unused, path: packages/core/src/Widgets/Concerns/WithWidgets.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/DispatchesStateUpdates.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithActionForms.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithFieldActions.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithFieldPartials.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithFileUploads.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/WithActions.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithRepeaters.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithSelectCreation.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithWizards.php }
        - { identifier: trait.unused, path: packages/forms/src/Forms/WithForms.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/CanExpandSubRows.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/CanFillCells.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/CanGroupRecords.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/InteractsWithTableActions.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/InteractsWithTableModals.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/CanSelectRecords.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/WithTable.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/WithTableQueryString.php }
        - { identifier: trait.unused, path: packages/core/src/Core/Resources/Concerns/DescribesRecords.php }
