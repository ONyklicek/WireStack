parameters:
    level: 6
    paths:
        - packages/core/src
        - packages/forms/src
        - packages/table/src
        - packages/panels/src
        - packages/boost/src
    tmpDir: build/phpstan
    excludePaths:
        # Concrete Livewire hosts that compose WithTable are not statically
        # analysable as concrete classes: WithTable relies on Livewire runtime
        # magic (dynamic __get/__set, method_exists guards, cross-trait calls)
        # and is only PHPStan-clean when checked as a trait via @phpstan-require-extends.
        # Every other concrete WithTable host (tests, workbench, wire-sortable) is
        # likewise outside the analysed paths; RelationManager is such a host base.
        - packages/table/src/RelationManagers/RelationManager.php
        # The resource pages are the same kind of host base: a concrete Livewire
        # component composing WithTable or WithForms, so analysing one as a class
        # drags the trait in as one too and reproduces the runtime-magic errors
        # above ($this->form comes from WithForms::__get, and so on).
        # ViewPage and Page belong here too since they host header actions: both
        # compose WithActions (through HostsPageActions), and analysing either as
        # a class drags the whole action engine in as one — the same runtime-magic
        # errors, plus every trait.unused ignore below going unmatched.
        - packages/panels/src/Resources/Pages/ListPage.php
        - packages/panels/src/Resources/Pages/CreatePage.php
        - packages/panels/src/Resources/Pages/EditPage.php
        - packages/panels/src/Resources/Pages/ViewPage.php
        - packages/panels/src/Pages/Page.php
        # PanelComponent is a concrete Livewire host composing WithEditablePanel;
        # like RelationManager it depends on Livewire runtime magic and is only
        # analysable via the trait's @phpstan-require-extends, not as a class.
        - packages/core/src/Panels/PanelComponent.php
    ignoreErrors:
        # Public-API traits meant for consumer code, not analyzed internally
        - { identifier: trait.unused, path: packages/core/src/Actions/Concerns/HasButtonStyles.php }
        - { identifier: trait.unused, path: packages/core/src/Actions/Concerns/InteractsWithActions.php }
        - { identifier: trait.unused, path: packages/core/src/Actions/Concerns/InteractsWithHalt.php }
        - { identifier: trait.unused, path: packages/core/src/Audit/Concerns/HasAuditable.php }
        - { identifier: trait.unused, path: packages/core/src/Foundation/Concerns/HasLivewire.php }
        - { identifier: trait.unused, path: packages/core/src/Infolists/Concerns/WithInfolists.php }
        - { identifier: trait.unused, path: packages/core/src/Panels/Concerns/WithEditablePanel.php }
        - { identifier: trait.unused, path: packages/core/src/Notifications/Concerns/InteractsWithNotifications.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/DispatchesStateUpdates.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithActionForms.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithFieldActions.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithFieldPartials.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithFileUploads.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/WithActions.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithRepeaters.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithSelectCreation.php }
        - { identifier: trait.unused, path: packages/forms/src/Concerns/InteractsWithWizards.php }
        - { identifier: trait.unused, path: packages/forms/src/Forms/WithForms.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/CanExpandSubRows.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/CanFillCells.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/CanGroupRecords.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/InteractsWithTableActions.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/InteractsWithTableModals.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/CanSelectRecords.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/WithTable.php }
        - { identifier: trait.unused, path: packages/table/src/Concerns/WithTableQueryString.php }
        # Both users are Livewire cards in wire-module-users, which is outside the
        # analysed paths — so "unused" is a fact about that list, not about the
        # trait. It carries no @phpstan-require-extends because it requires
        # nothing of its host: it reads the session and Gate, and the one host
        # method it reaches for (`redirect()`) is guarded by method_exists,
        # precisely so a non-Livewire caller is a supported case rather than a
        # fatal.
        - { identifier: trait.unused, path: packages/core/src/Foundation/Concerns/InteractsWithPasswordConfirmation.php }
        # Composed by resource pages in the module packages, which are outside the
        # analysed paths — so "unused" is a fact about this list, not about the
        # trait. Unlike the host traits above it carries
        # `@phpstan-require-extends ViewPage`, so its body is still checked
        # against the class it is written for; only the unused verdict is muted.
        - { identifier: trait.unused, path: packages/panels/src/Resources/Concerns/InteractsWithRecordTitle.php }
        # Same fact about this list: its two users are CreatePage and EditPage,
        # both excluded above as Livewire hosts.
        - { identifier: trait.unused, path: packages/panels/src/Resources/Concerns/RedirectsAfterSave.php }
        # The list page's tabs and the form pages' unsaved-changes switch: their
        # only users are ListPage, CreatePage and EditPage, all excluded above as
        # Livewire hosts. InteractsWithListTabs carries @phpstan-require-extends
        # ListPage, so its body is still checked against the class it serves.
        - { identifier: trait.unused, path: packages/panels/src/Resources/Concerns/InteractsWithListTabs.php }
        - { identifier: trait.unused, path: packages/panels/src/Resources/Concerns/InteractsWithUnsavedChanges.php }
        - { identifier: trait.unused, path: packages/panels/src/Resources/Concerns/InteractsWithTrashedRecords.php }
        # Every page composing these is a Livewire host excluded above — ViewPage
        # and Page joined the list when they began hosting header actions — so
        # "unused" is again a fact about the analysed paths, not the traits.
        - { identifier: trait.unused, path: packages/panels/src/Pages/Concerns/HostsPageActions.php }
        - { identifier: trait.unused, path: packages/panels/src/Pages/Concerns/InteractsWithHeaderActions.php }
        - { identifier: trait.unused, path: packages/panels/src/Pages/Concerns/InteractsWithPageWidgets.php }
        - { identifier: trait.unused, path: packages/panels/src/Resources/Concerns/BelongsToParentRecord.php }
        - { identifier: trait.unused, path: packages/panels/src/Resources/Concerns/BelongsToResource.php }
        - { identifier: trait.unused, path: packages/panels/src/Resources/Concerns/CanDeleteRecord.php }
        - { identifier: trait.unused, path: packages/panels/src/Resources/Concerns/EmbedsRelationManagers.php }
        - { identifier: trait.unused, path: packages/panels/src/Resources/Concerns/LinksToRecordPages.php }
        - { identifier: trait.unused, path: packages/panels/src/Resources/Concerns/ResolvesOneRecord.php }
        # Every user is a resource page in wire-module-users or
        # wire-module-notifications, all outside the analysed paths. No
        # @phpstan-require-extends to keep the body checked, unlike
        # InteractsWithRecordTitle: this trait overrides a method it inherits
        # from a *sibling* trait and calls `parent::resolveRecord()`, which
        # resolves through the host class rather than through any base this
        # could name. ViewPage and EditPage both compose ResolvesOneRecord and
        # share no record-page ancestor, so there is no honest constraint to
        # write — and writing Component would be a claim the body contradicts.
        - { identifier: trait.unused, path: packages/panels/src/Resources/Concerns/ResolvesScopedRecord.php }
        - { identifier: trait.unused, path: packages/core/src/Core/Resources/Concerns/DescribesRecords.php }
        - { identifier: trait.unused, path: packages/core/src/Core/Tenancy/Concerns/BelongsToTenant.php }
