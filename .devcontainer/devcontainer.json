{
    "name": "WireStack",

    // The compose file is what builds the Dockerfile and ships php.ini and
    // xdebug.ini; a bare "image" here used to bypass all three.
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "runServices": ["app", "mysql", "mariadb", "postgres", "redis", "mailpit"],
    "workspaceFolder": "/workspaces/WireStack",
    "shutdownAction": "stopCompose",
    "remoteUser": "vscode",

    "features": {
        // CI's docs and asset jobs run on Node 22.
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },

    "forwardPorts": [8085, 5173, "mailpit:8025"],

    "portsAttributes": {
        "8085": {
            "label": "Workbench (testbench serve)",
            "onAutoForward": "notify"
        },
        "5173": {
            "label": "Vite",
            "onAutoForward": "silent"
        },
        "mailpit:8025": {
            "label": "Mailpit"
        },
        "9003": {
            "label": "Xdebug",
            "onAutoForward": "ignore"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "laravel.vscode-laravel",
                "bmewburn.vscode-intelephense-client",
                "xdebug.php-debug",
                "open-southeners.laravel-pint",
                "m1guelpf.better-pest",
                "onecentlin.laravel-blade",
                "bradlc.vscode-tailwindcss",
                "eamodio.gitlens",
                "EditorConfig.EditorConfig",
                "GitHub.copilot",
                "GitHub.copilot-chat"
            ],

            "settings": {
                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true,

                "php.validate.executablePath": "/usr/local/bin/php",
                "intelephense.environment.phpVersion": "8.2.0",
                "intelephense.files.exclude": [
                    "**/.git/**",
                    "**/node_modules/**",
                    "**/docs-site/dist/**",
                    "**/build/**"
                ],

                // pint.json is the style; Intelephense's formatter is not.
                "laravel-pint.enable": true,
                "[php]": {
                    "editor.defaultFormatter": "open-southeners.laravel-pint",
                    "editor.formatOnSave": true
                },

                // No Blade formatter on save: `@wireEl('…')` hooks must stay
                // inside their opening tags (npm run hooks:verify).
                "[blade]": {
                    "editor.formatOnSave": false
                },

                "files.watcherExclude": {
                    "**/vendor/**": true,
                    "**/node_modules/**": true,
                    "**/docs-site/dist/**": true,
                    "**/build/**": true
                },

                "launch": {
                    "version": "0.2.0",
                    "configurations": [
                        {
                            "name": "Listen for Xdebug",
                            "type": "php",
                            "request": "launch",
                            "port": 9003
                        }
                    ]
                }
            }
        }
    },

    "postCreateCommand": "bash .devcontainer/post-create.sh"
}
