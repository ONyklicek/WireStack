{
    "name": "Laravel AI Development",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },

    "remoteUser": "vscode",

    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },

    "forwardPorts": [
        8000,
        5173,
        8080
    ],

    "portsAttributes": {
        "8000": {
            "label": "Laravel",
            "onAutoForward": "notify"
        },
        "5173": {
            "label": "Vite",
            "onAutoForward": "silent"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "xdebug.php-debug",
                "onecentlin.laravel-blade",
                "shufo.vscode-blade-formatter",
                "stef-k.laravel-goto",
                "bradlc.vscode-tailwindcss",
                "mikestead.dotenv",
                "redhat.vscode-yaml",
                "eamodio.gitlens",
                "EditorConfig.EditorConfig"
            ],

            "settings": {
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.fixAll": "explicit"
                },

                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true,

                "php.validate.executablePath": "/usr/local/bin/php",

                "intelephense.environment.phpVersion": "8.4.0",
                "intelephense.files.maxSize": 5000000,

                "[php]": {
                    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
                },

                "[blade]": {
                    "editor.defaultFormatter": "shufo.vscode-blade-formatter"
                },

                "[javascript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },

                "[typescript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                }
            }
        }
    },

    "postCreateCommand": "composer install && npm install",

    "postStartCommand": "php artisan storage:link 2>/dev/null || true",

    "mounts": [
        "source=laravel-composer-cache,target=/home/vscode/.composer,type=volume",
        "source=laravel-npm-cache,target=/home/vscode/.npm,type=volume"
    ]
}
