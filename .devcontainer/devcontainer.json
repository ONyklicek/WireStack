{
    "name": "WireStack Laravel",

    "image": "mcr.microsoft.com/devcontainers/php:4-8.4-trixie",

    "features": {
        "ghcr.io/devcontainers/features/node:2": {
            "version": "24"
        },

        "ghcr.io/devcontainers/features/github-cli:1": {}
    },

    "forwardPorts": [
        8000,
        5173
    ],

    "portsAttributes": {
        "8000": {
            "label": "Laravel",
            "onAutoForward": "openBrowser"
        },

        "5173": {
            "label": "Vite",
            "onAutoForward": "silent"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "laravel.vscode-laravel",
                "bmewburn.vscode-intelephense-client",
                "ikappas.composer",
                "onecentlin.laravel-blade",
                "shufo.vscode-blade-formatter",
                "bradlc.vscode-tailwindcss",
                "stef-k.laravel-goto",
                "eamodio.gitlens",
                "EditorConfig.EditorConfig",
                "GitHub.copilot",
                "GitHub.copilot-chat"
            ],

            "settings": {
                "editor.formatOnSave": true,

                "editor.codeActionsOnSave": {
                    "source.fixAll": "explicit"
                },

                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true,

                "intelephense.environment.phpVersion": "8.4.0",

                "[php]": {
                    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
                },

                "[blade]": {
                    "editor.defaultFormatter": "shufo.vscode-blade-formatter"
                }
            }
        }
    },

    "postCreateCommand": "composer install && npm install",

    "postStartCommand": "php artisan storage:link 2>/dev/null || true"
}
