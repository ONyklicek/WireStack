<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Suite Unit">
            <directory>packages/suite/tests/Unit</directory>
        </testsuite>
        <testsuite name="Suite Feature">
            <directory>packages/suite/tests/Feature</directory>
        </testsuite>
        <testsuite name="Core Unit">
            <directory>packages/core/tests/Unit</directory>
        </testsuite>
        <testsuite name="Core Feature">
            <directory>packages/core/tests/Feature</directory>
        </testsuite>
        <testsuite name="Forms Unit">
            <directory>packages/forms/tests/Unit</directory>
        </testsuite>
        <testsuite name="Forms Feature">
            <directory>packages/forms/tests/Feature</directory>
        </testsuite>
        <testsuite name="Table Unit">
            <directory>packages/table/tests/Unit</directory>
        </testsuite>
        <testsuite name="Table Feature">
            <directory>packages/table/tests/Feature</directory>
        </testsuite>
        <testsuite name="Table Benchmarks">
            <directory>packages/table/tests/Benchmarks</directory>
        </testsuite>
        <testsuite name="Panels Unit">
            <directory>packages/panels/tests/Unit</directory>
        </testsuite>
        <testsuite name="Panels Feature">
            <directory>packages/panels/tests/Feature</directory>
        </testsuite>
        <testsuite name="Admin Unit">
            <directory>packages/admin/tests/Unit</directory>
        </testsuite>
        <testsuite name="Admin Feature">
            <directory>packages/admin/tests/Feature</directory>
        </testsuite>
        <testsuite name="Module Audit Unit">
            <directory>packages/module-audit/tests/Unit</directory>
        </testsuite>
        <testsuite name="Module Audit Feature">
            <directory>packages/module-audit/tests/Feature</directory>
        </testsuite>
        <testsuite name="Module Auth Unit">
            <directory>packages/module-auth/tests/Unit</directory>
        </testsuite>
        <testsuite name="Module Auth Feature">
            <directory>packages/module-auth/tests/Feature</directory>
        </testsuite>
        <testsuite name="Module Notifications Unit">
            <directory>packages/module-notifications/tests/Unit</directory>
        </testsuite>
        <testsuite name="Module Notifications Feature">
            <directory>packages/module-notifications/tests/Feature</directory>
        </testsuite>
        <testsuite name="Module Settings Unit">
            <directory>packages/module-settings/tests/Unit</directory>
        </testsuite>
        <testsuite name="Module Settings Feature">
            <directory>packages/module-settings/tests/Feature</directory>
        </testsuite>
        <testsuite name="Module Media Unit">
            <directory>packages/module-media/tests/Unit</directory>
        </testsuite>
        <testsuite name="Module Media Feature">
            <directory>packages/module-media/tests/Feature</directory>
        </testsuite>
        <testsuite name="Module Users Unit">
            <directory>packages/module-users/tests/Unit</directory>
        </testsuite>
        <testsuite name="Module Users Feature">
            <directory>packages/module-users/tests/Feature</directory>
        </testsuite>
        <testsuite name="Sortable Unit">
            <directory>packages/sortable/tests/Unit</directory>
        </testsuite>
        <testsuite name="Sortable Feature">
            <directory>packages/sortable/tests/Feature</directory>
        </testsuite>
        <testsuite name="Forms Standalone">
            <directory>packages/forms/tests/Standalone</directory>
        </testsuite>
        <testsuite name="Boost Unit">
            <directory>packages/boost/tests/Unit</directory>
        </testsuite>
        <testsuite name="Boost Feature">
            <directory>packages/boost/tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/suite/src</directory>
            <directory>packages/core/src</directory>
            <directory>packages/forms/src</directory>
            <directory>packages/table/src</directory>
            <directory>packages/panels/src</directory>
            <directory>packages/admin/src</directory>
            <directory>packages/module-users/src</directory>
            <directory>packages/module-media/src</directory>
            <directory>packages/module-settings/src</directory>
            <directory>packages/module-notifications/src</directory>
            <directory>packages/module-audit/src</directory>
            <directory>packages/module-auth/src</directory>
            <directory>packages/sortable/src</directory>
            <directory>packages/boost/src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Both keys: CACHE_DRIVER is what Laravel 10 read, CACHE_STORE what 11
             reads, and testbench's own .env sets the latter to `database` —
             whose table this suite has no reason to migrate. -->
        <env name="CACHE_DRIVER" value="array"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_DRIVER" value="sync"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
    </php>
</phpunit>
